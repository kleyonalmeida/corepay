<div class="payroll-detail-entry__actions">
    @if (ShowApproveEntry)
    {
        <Button Variant="ButtonVariant.Outline"
                Size="ButtonSize.Sm"
                Disabled="@IsBusy"
                OnClick="@OnApproveEntry">
            Aprovar colaborador
        </Button>
    }

    @if (ShowPayEntry)
    {
        <Button Variant="ButtonVariant.Outline"
                Size="ButtonSize.Sm"
                Disabled="@IsBusy"
                OnClick="@OnPayEntry">
            @PayLabel
        </Button>
    }

    @if (ShowToggleNf)
    {
        <Button Variant="ButtonVariant.Ghost"
                Size="ButtonSize.Sm"
                Disabled="@IsBusy"
                OnClick="@OnToggleNf">
            @NfLabel
        </Button>
    }
</div>

@code {
    [Parameter] public bool ShowApproveEntry { get; set; }
    [Parameter] public bool ShowPayEntry { get; set; }
    [Parameter] public bool ShowToggleNf { get; set; }
    [Parameter] public bool IsPaid { get; set; }
    [Parameter] public bool NfSent { get; set; }
    [Parameter] public bool IsBusy { get; set; }
    [Parameter] public EventCallback OnApproveEntry { get; set; }
    [Parameter] public EventCallback OnPayEntry { get; set; }
    [Parameter] public EventCallback OnToggleNf { get; set; }

    private string PayLabel => IsPaid ? "Desmarcar pago" : "Marcar pago";
    private string NfLabel => NfSent ? "Desmarcar NF" : "Marcar NF enviada";
}
