@inject IProjectRevenueApiService ProjectRevenueApiService
@inject IProjectApiService ProjectApiService
@inject IAuthorizationService AuthorizationService
@inject AuthenticationStateProvider AuthenticationStateProvider

<div class="project-revenues-page">
    @if (!string.IsNullOrWhiteSpace(_actionMessage))
    {
        <div class="project-revenues-action-message" role="status">@_actionMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(_actionError))
    {
        <div class="project-revenues-action-error" role="alert">@_actionError</div>
    }

    <Card Class="project-revenues-filters-card">
        <ChildContent>
            <div class="project-revenues-filters">
                <Select Label="Mês"
                        Value="@_monthFilter"
                        ValueChanged="@OnMonthFilterChangedAsync">
                    @for (var month = 1; month <= 12; month++)
                    {
                        <option value="@month">@CompetenceFormatter.Format(month, 2000).Split('/')[0]</option>
                    }
                </Select>
                <Select Label="Ano"
                        Value="@_yearFilter"
                        ValueChanged="@OnYearFilterChangedAsync">
                    @foreach (var year in _yearOptions)
                    {
                        <option value="@year">@year</option>
                    }
                </Select>
                <Select Label="Projeto"
                        Value="@_projectFilter"
                        ValueChanged="@OnProjectFilterChangedAsync"
                        Disabled="@_isLoadingProjects">
                    <option value="">Todos os projetos</option>
                    @foreach (var project in _projects)
                    {
                        <option value="@project.Id">@project.Name</option>
                    }
                </Select>
            </div>
        </ChildContent>
    </Card>

    <Card Class="project-revenues-table-card">
        <HeaderContent>
            <SectionCardHeader Title="Faturamento por projeto" Icon="IconKind.TrendingUp">
                <Actions>
                    @if (_canWrite)
                    {
                        <Button Size="ButtonSize.Sm" OnClick="@OpenCreateDialogAsync">
                            Novo faturamento
                        </Button>
                    }
                </Actions>
            </SectionCardHeader>
        </HeaderContent>
        <ChildContent>
            @if (_isLoading)
            {
                <div class="settings-section__loading">
                    <Spinner Label="Carregando faturamento..." />
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(_loadError))
            {
                <EmptyState Title="Erro ao carregar faturamento" Description="@_loadError" />
            }
            else if (_revenues.Count == 0)
            {
                <EmptyState Title="Nenhum faturamento encontrado"
                            Description="@GetEmptyStateDescription()" />
            }
            else
            {
                <div class="settings-table-wrapper">
                    <table class="settings-table project-revenues-table">
                        <thead>
                            <tr>
                                <th>Projeto</th>
                                <th>Competência</th>
                                <th class="project-revenues-table__money">iGaming</th>
                                <th class="project-revenues-table__money">Vendas</th>
                                <th class="project-revenues-table__money">Total</th>
                                <th class="project-revenues-table__percent">% Grupo</th>
                                <th>Observações</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var revenue in _revenues)
                            {
                                <tr>
                                    <td>@revenue.ProjectName</td>
                                    <td class="tabular-nums">@CompetenceFormatter.Format(revenue.Month, revenue.Year)</td>
                                    <td class="project-revenues-table__money text-table-money tabular-nums">
                                        @MoneyFormatter.FormatMoney(revenue.ValueIgaming)
                                    </td>
                                    <td class="project-revenues-table__money text-table-money tabular-nums">
                                        @MoneyFormatter.FormatMoney(revenue.ValueVendas)
                                    </td>
                                    <td class="project-revenues-table__money text-table-money tabular-nums">
                                        @MoneyFormatter.FormatMoney(revenue.Value)
                                    </td>
                                    <td class="project-revenues-table__percent tabular-nums">
                                        @revenue.GroupPercentage.ToString("0.##")%
                                    </td>
                                    <td class="project-revenues-table__notes">
                                        @(string.IsNullOrWhiteSpace(revenue.Notes) ? "—" : revenue.Notes)
                                    </td>
                                    <td class="settings-table__actions">
                                        @if (_canWrite)
                                        {
                                            <Button Variant="ButtonVariant.Ghost"
                                                    Size="ButtonSize.Sm"
                                                    OnClick="@(() => OpenEditDialogAsync(revenue))">
                                                Editar
                                            </Button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </ChildContent>
    </Card>
</div>

<ProjectRevenueFormDialog IsOpen="@_dialogOpen"
                          IsOpenChanged="@OnDialogOpenChangedAsync"
                          EditTarget="@_editTarget"
                          Projects="@_projects"
                          YearOptions="@_yearOptions"
                          DefaultMonth="@_defaultMonth"
                          DefaultYear="@_defaultYear"
                          IsSaving="@_isSaving"
                          ErrorMessage="@_formError"
                          OnSubmit="@SaveAsync" />

@code {
    private readonly List<ProjectRevenueDto> _revenues = [];
    private readonly List<ProjectDto> _projects = [];
    private readonly int[] _yearOptions = BuildYearOptions();

    private bool _isLoading = true;
    private bool _isLoadingProjects = true;
    private bool _isSaving;
    private bool _canWrite;
    private string? _loadError;
    private string? _actionMessage;
    private string? _actionError;
    private string? _formError;
    private bool _dialogOpen;
    private ProjectRevenueDto? _editTarget;

    private string _monthFilter = string.Empty;
    private string _yearFilter = string.Empty;
    private string _projectFilter = string.Empty;
    private int _defaultMonth;
    private int _defaultYear;

    protected override async Task OnInitializedAsync()
    {
        var now = DateTime.UtcNow;
        _defaultMonth = now.Month;
        _defaultYear = now.Year;
        _monthFilter = _defaultMonth.ToString();
        _yearFilter = _defaultYear.ToString();

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var writeAuthorization = await AuthorizationService.AuthorizeAsync(
            authState.User,
            AppPolicies.RevenuesWrite);
        _canWrite = writeAuthorization.Succeeded;

        await LoadProjectsAsync();
        await LoadRevenuesAsync();
    }

    private static int[] BuildYearOptions()
    {
        var currentYear = DateTime.UtcNow.Year;
        return Enumerable.Range(currentYear - 2, 5).Reverse().ToArray();
    }

    private async Task LoadProjectsAsync()
    {
        _isLoadingProjects = true;
        _projects.Clear();

        var result = await ProjectApiService.GetProjectsAsync();
        if (result.Status == ProjectApiStatus.Success && result.Projects is not null)
        {
            _projects.AddRange(result.Projects.OrderBy(p => p.Name, StringComparer.OrdinalIgnoreCase));
        }

        _isLoadingProjects = false;
    }

    private async Task LoadRevenuesAsync()
    {
        _isLoading = true;
        _loadError = null;
        _revenues.Clear();
        _actionMessage = null;
        _actionError = null;

        var result = await ProjectRevenueApiService.GetRevenuesAsync(BuildListQuery());
        if (result.Status == ProjectRevenueApiStatus.Success && result.Revenues is not null)
        {
            _revenues.AddRange(result.Revenues);
        }
        else
        {
            _loadError = ProjectRevenueErrorMessages.ForList(result);
        }

        _isLoading = false;
    }

    private ProjectRevenueListQuery BuildListQuery() =>
        new(
            ParseIntFilter(_monthFilter),
            ParseIntFilter(_yearFilter),
            ParseGuidFilter(_projectFilter));

    private static int? ParseIntFilter(string value) =>
        int.TryParse(value, out var parsed) ? parsed : null;

    private static Guid? ParseGuidFilter(string value) =>
        Guid.TryParse(value, out var parsed) ? parsed : null;

    private string GetEmptyStateDescription() =>
        _canWrite
            ? "Cadastre o faturamento do mês ou ajuste os filtros."
            : "Ajuste os filtros para encontrar registros.";

    private async Task OnMonthFilterChangedAsync(string? value)
    {
        _monthFilter = value ?? string.Empty;
        await LoadRevenuesAsync();
    }

    private async Task OnYearFilterChangedAsync(string? value)
    {
        _yearFilter = value ?? string.Empty;
        await LoadRevenuesAsync();
    }

    private async Task OnProjectFilterChangedAsync(string? value)
    {
        _projectFilter = value ?? string.Empty;
        await LoadRevenuesAsync();
    }

    private Task OpenCreateDialogAsync()
    {
        _editTarget = null;
        _formError = null;
        _dialogOpen = true;
        return Task.CompletedTask;
    }

    private Task OpenEditDialogAsync(ProjectRevenueDto revenue)
    {
        _editTarget = revenue;
        _formError = null;
        _dialogOpen = true;
        return Task.CompletedTask;
    }

    private Task OnDialogOpenChangedAsync(bool isOpen)
    {
        _dialogOpen = isOpen;
        if (!isOpen)
        {
            _editTarget = null;
            _formError = null;
        }

        return Task.CompletedTask;
    }

    private async Task SaveAsync(ProjectRevenueRequest request)
    {
        _isSaving = true;
        _formError = null;
        _actionMessage = null;
        _actionError = null;

        ProjectRevenueMutationResult result = _editTarget is null
            ? await ProjectRevenueApiService.CreateRevenueAsync(request)
            : await ProjectRevenueApiService.UpdateRevenueAsync(_editTarget.Id, request);

        if (result.Status == ProjectRevenueApiStatus.Success && result.Revenue is not null)
        {
            _dialogOpen = false;
            _editTarget = null;
            _monthFilter = result.Revenue.Month.ToString();
            _yearFilter = result.Revenue.Year.ToString();
            _actionMessage = "Faturamento salvo com sucesso.";
            await LoadRevenuesAsync();
        }
        else
        {
            _formError = ProjectRevenueErrorMessages.ForMutation(result);
        }

        _isSaving = false;
    }
}
