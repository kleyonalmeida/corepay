@inject ITrafficInvestmentApiService TrafficInvestmentApiService
@inject IProjectApiService ProjectApiService
@inject IAuthorizationService AuthorizationService
@inject AuthenticationStateProvider AuthenticationStateProvider

<div class="traffic-deposits-section">
    <Card Class="traffic-deposits-filters-card">
        <ChildContent>
            <div class="traffic-deposits-filters">
                <Select Label="Mês"
                        Value="@_monthFilter"
                        ValueChanged="@OnMonthFilterChangedAsync">
                    @for (var month = 1; month <= 12; month++)
                    {
                        <option value="@month">@CompetenceFormatter.Format(month, 2000).Split('/')[0]</option>
                    }
                </Select>
                <Select Label="Ano"
                        Value="@_yearFilter"
                        ValueChanged="@OnYearFilterChangedAsync">
                    @foreach (var year in _yearOptions)
                    {
                        <option value="@year">@year</option>
                    }
                </Select>
                <Select Label="Projeto"
                        Value="@_projectFilter"
                        ValueChanged="@OnProjectFilterChangedAsync"
                        Disabled="@_isLoadingProjects">
                    <option value="">Todos os projetos</option>
                    @foreach (var project in _projects)
                    {
                        <option value="@project.Id">@project.Name</option>
                    }
                </Select>
            </div>
        </ChildContent>
    </Card>

    <Card Class="traffic-deposits-table-card">
        <HeaderContent>
            <SectionCardHeader Title="Aportes por data" Icon="IconKind.Wallet">
                <Actions>
                    @if (_canWrite)
                    {
                        <Button Size="ButtonSize.Sm" OnClick="@OpenCreateDialogAsync">
                            Novo aporte
                        </Button>
                    }
                </Actions>
            </SectionCardHeader>
        </HeaderContent>
        <ChildContent>
            @if (_isLoading)
            {
                <div class="settings-section__loading">
                    <Spinner Label="Carregando aportes..." />
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(_loadError))
            {
                <EmptyState Title="Erro ao carregar aportes" Description="@_loadError" />
            }
            else if (_deposits.Count == 0)
            {
                <EmptyState Title="Nenhum aporte encontrado"
                            Description="Cadastre um aporte ou ajuste os filtros." />
            }
            else
            {
                <div class="settings-table-wrapper">
                    <table class="settings-table traffic-deposits-table">
                        <thead>
                            <tr>
                                <th>Data</th>
                                <th>Projeto</th>
                                <th class="traffic-deposits-table__money">Valor</th>
                                <th>Observações</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var deposit in _deposits)
                            {
                                <tr>
                                    <td class="tabular-nums">@DateFormatter.FormatDate(deposit.DepositDate)</td>
                                    <td>@deposit.ProjectName</td>
                                    <td class="traffic-deposits-table__money text-table-money tabular-nums">
                                        @MoneyFormatter.FormatMoney(deposit.Amount)
                                    </td>
                                    <td>@(string.IsNullOrWhiteSpace(deposit.Notes) ? "—" : deposit.Notes)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </ChildContent>
    </Card>
</div>

<Dialog IsOpen="@_dialogOpen" IsOpenChanged="@OnDialogOpenChangedAsync" Title="Novo aporte">
    <div class="settings-form">
        @if (!string.IsNullOrWhiteSpace(_formError))
        {
            <p class="settings-form__error" role="alert">@_formError</p>
        }

        <Select Label="Projeto"
                Value="@_projectId"
                ValueChanged="@(value => _projectId = value ?? string.Empty)"
                Disabled="@_isSaving">
            <option value="">Selecione um projeto</option>
            @foreach (var project in _projects.Where(project => project.IsActive).OrderBy(project => project.Name))
            {
                <option value="@project.Id">@project.Name</option>
            }
        </Select>

        <Input Label="Data"
               Value="@_depositDate"
               ValueChanged="@(value => _depositDate = value ?? string.Empty)"
               Disabled="@_isSaving" />

        <Input Label="Valor"
               IsMoney="true"
               Value="@_amount"
               ValueChanged="@(value => _amount = value ?? "0")"
               Disabled="@_isSaving" />

        <div class="ui-field">
            <label class="text-label ui-field__label" for="@NotesId">Observações</label>
            <textarea id="@NotesId"
                      class="ui-input traffic-deposits-form__notes"
                      rows="3"
                      disabled="@_isSaving"
                      @bind="_notes"></textarea>
        </div>

        <FormDialogActions IsSaving="@_isSaving"
                           SubmitLabel="@(_isSaving ? "Salvando..." : "Registrar")"
                           OnSubmit="@SaveDepositAsync"
                           OnCancel="@CloseDialogAsync" />
    </div>
</Dialog>

@code {
    private readonly List<TrafficProjectDepositDto> _deposits = [];
    private readonly List<ProjectDto> _projects = [];
    private readonly int[] _yearOptions = BuildYearOptions();

    private bool _isLoading = true;
    private bool _isLoadingProjects = true;
    private bool _isSaving;
    private bool _canWrite;
    private bool _dialogOpen;
    private string? _loadError;
    private string? _formError;
    private string _monthFilter = string.Empty;
    private string _yearFilter = string.Empty;
    private string _projectFilter = string.Empty;
    private string _projectId = string.Empty;
    private string _depositDate = string.Empty;
    private string _amount = "0";
    private string _notes = string.Empty;
    private string NotesId { get; } = $"traffic-deposit-notes-{Guid.NewGuid():N}";

    protected override async Task OnInitializedAsync()
    {
        var now = DateTime.UtcNow;
        _monthFilter = now.Month.ToString();
        _yearFilter = now.Year.ToString();
        _depositDate = DateInputParser.FormatDateInput(DateOnly.FromDateTime(now));

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var writeAuthorization = await AuthorizationService.AuthorizeAsync(
            authState.User,
            AppPolicies.TrafficWrite);
        _canWrite = writeAuthorization.Succeeded;

        await LoadProjectsAsync();
        await LoadDepositsAsync();
    }

    private static int[] BuildYearOptions()
    {
        var currentYear = DateTime.UtcNow.Year;
        return Enumerable.Range(currentYear - 2, 5).Reverse().ToArray();
    }

    private async Task LoadProjectsAsync()
    {
        _isLoadingProjects = true;
        _projects.Clear();

        var result = await ProjectApiService.GetProjectsAsync();
        if (result.Status == ProjectApiStatus.Success && result.Projects is not null)
        {
            _projects.AddRange(result.Projects.OrderBy(project => project.Name, StringComparer.OrdinalIgnoreCase));
        }

        _isLoadingProjects = false;
    }

    private async Task LoadDepositsAsync()
    {
        _isLoading = true;
        _loadError = null;
        _deposits.Clear();

        var result = await TrafficInvestmentApiService.GetProjectDepositsAsync(BuildListQuery());
        if (result.Status == TrafficInvestmentApiStatus.Success && result.Deposits is not null)
        {
            _deposits.AddRange(result.Deposits);
        }
        else
        {
            _loadError = TrafficInvestmentErrorMessages.ForProjectDepositList(result);
        }

        _isLoading = false;
    }

    private TrafficProjectDepositListQuery BuildListQuery() =>
        new(
            ParseIntFilter(_monthFilter),
            ParseIntFilter(_yearFilter),
            ParseGuidFilter(_projectFilter));

    private static int? ParseIntFilter(string value) =>
        int.TryParse(value, out var parsed) ? parsed : null;

    private static Guid? ParseGuidFilter(string value) =>
        Guid.TryParse(value, out var parsed) ? parsed : null;

    private async Task OnMonthFilterChangedAsync(string? value)
    {
        _monthFilter = value ?? string.Empty;
        await LoadDepositsAsync();
    }

    private async Task OnYearFilterChangedAsync(string? value)
    {
        _yearFilter = value ?? string.Empty;
        await LoadDepositsAsync();
    }

    private async Task OnProjectFilterChangedAsync(string? value)
    {
        _projectFilter = value ?? string.Empty;
        await LoadDepositsAsync();
    }

    private Task OpenCreateDialogAsync()
    {
        _formError = null;
        _projectId = _projectFilter;
        _amount = "0";
        _notes = string.Empty;
        _dialogOpen = true;
        return Task.CompletedTask;
    }

    private Task OnDialogOpenChangedAsync(bool isOpen)
    {
        _dialogOpen = isOpen;
        if (!isOpen)
        {
            _formError = null;
        }

        return Task.CompletedTask;
    }

    private async Task CloseDialogAsync()
    {
        _dialogOpen = false;
        await Task.CompletedTask;
    }

    private async Task SaveDepositAsync()
    {
        _isSaving = true;
        _formError = null;

        if (!Guid.TryParse(_projectId, out var projectId))
        {
            _formError = "Selecione um projeto.";
            _isSaving = false;
            return;
        }

        if (!DateInputParser.TryParseDateOnly(_depositDate, out var depositDate))
        {
            _formError = "Informe uma data válida.";
            _isSaving = false;
            return;
        }

        var amount = ParseMoney(_amount);
        if (amount <= 0m)
        {
            _formError = "O valor do aporte deve ser maior que zero.";
            _isSaving = false;
            return;
        }

        var request = new TrafficProjectDepositRequest(
            projectId,
            depositDate,
            amount,
            string.IsNullOrWhiteSpace(_notes) ? null : _notes.Trim());

        var result = await TrafficInvestmentApiService.CreateProjectDepositAsync(request);
        if (result.Status == TrafficInvestmentApiStatus.Success)
        {
            _dialogOpen = false;
            await LoadDepositsAsync();
        }
        else
        {
            _formError = TrafficInvestmentErrorMessages.ForProjectDepositMutation(result);
        }

        _isSaving = false;
    }

    private static decimal ParseMoney(string? value) =>
        DecimalInputParser.TryParse(value, out var parsed) ? parsed : 0m;
}
