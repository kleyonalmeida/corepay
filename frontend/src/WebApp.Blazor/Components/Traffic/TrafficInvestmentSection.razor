@inject ITrafficInvestmentApiService TrafficInvestmentApiService
@inject IProjectApiService ProjectApiService
@inject IAuthorizationService AuthorizationService
@inject AuthenticationStateProvider AuthenticationStateProvider

<div class="traffic-investment-page">
    @if (!string.IsNullOrWhiteSpace(_actionMessage))
    {
        <div class="traffic-investment-action-message" role="status">@_actionMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(_actionError))
    {
        <div class="traffic-investment-action-error" role="alert">@_actionError</div>
    }

    @if (_activeTab == 0)
    {
        <Card Class="traffic-investment-filters-card">
            <ChildContent>
                <div class="traffic-investment-filters">
                    <Select Label="Mês"
                            Value="@_monthFilter"
                            ValueChanged="@OnMonthFilterChangedAsync">
                        @for (var month = 1; month <= 12; month++)
                        {
                            <option value="@month">@CompetenceFormatter.Format(month, 2000).Split('/')[0]</option>
                        }
                    </Select>
                    <Select Label="Ano"
                            Value="@_yearFilter"
                            ValueChanged="@OnYearFilterChangedAsync">
                        @foreach (var year in _yearOptions)
                        {
                            <option value="@year">@year</option>
                        }
                    </Select>
                    <Select Label="Projeto"
                            Value="@_projectFilter"
                            ValueChanged="@OnProjectFilterChangedAsync"
                            Disabled="@_isLoadingProjects">
                        <option value="">Todos os projetos</option>
                        @foreach (var project in _projects)
                        {
                            <option value="@project.Id">@project.Name</option>
                        }
                    </Select>
                </div>
            </ChildContent>
        </Card>
    }

    <Tabs Items="@_tabs"
          ActiveTab="@_activeTab"
          ActiveTabChanged="@OnTabChangedAsync"
          AriaLabel="Investimento de tráfego">
        @if (_activeTab == 0)
        {
            <Card Class="traffic-investment-table-card">
                <HeaderContent>
                    <SectionCardHeader Title="Investimentos por projeto" Icon="IconKind.Target">
                        <Actions>
                            @if (_canWrite)
                            {
                                <Button Size="ButtonSize.Sm" OnClick="@OpenCreateDialogAsync">
                                    Novo investimento
                                </Button>
                            }
                        </Actions>
                    </SectionCardHeader>
                </HeaderContent>
                <ChildContent>
                    @if (_isLoading)
                    {
                        <div class="settings-section__loading">
                            <Spinner Label="Carregando investimentos..." />
                        </div>
                    }
                    else if (!string.IsNullOrWhiteSpace(_loadError))
                    {
                        <EmptyState Title="Erro ao carregar investimentos" Description="@_loadError" />
                    }
                    else if (_investments.Count == 0)
                    {
                        <EmptyState Title="Nenhum investimento encontrado"
                                    Description="@GetEmptyStateDescription()" />
                    }
                    else
                    {
                        <div class="settings-table-wrapper">
                            <table class="settings-table traffic-investment-table">
                                <thead>
                                    <tr>
                                        <th>Projeto</th>
                                        <th>Competência</th>
                                        <th class="traffic-investment-table__money">Meta</th>
                                        <th class="traffic-investment-table__money">Gasto</th>
                                        <th class="traffic-investment-table__money">Imposto</th>
                                        <th class="traffic-investment-table__money">Total</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var investment in _investments)
                                    {
                                        <tr>
                                            <td>@investment.ProjectName</td>
                                            <td class="tabular-nums">@CompetenceFormatter.Format(investment.Month, investment.Year)</td>
                                            <td class="traffic-investment-table__money text-table-money tabular-nums">
                                                @MoneyFormatter.FormatMoney(investment.MonthlyTarget)
                                            </td>
                                            <td class="traffic-investment-table__money text-table-money tabular-nums">
                                                @MoneyFormatter.FormatMoney(investment.MonthlyTotals.SpentAmount)
                                            </td>
                                            <td class="traffic-investment-table__money text-table-money tabular-nums">
                                                @MoneyFormatter.FormatMoney(investment.MonthlyTotals.TaxAmount)
                                            </td>
                                            <td class="traffic-investment-table__money text-table-money tabular-nums">
                                                @MoneyFormatter.FormatMoney(investment.MonthlyTotals.TotalAmount)
                                            </td>
                                            <td class="settings-table__actions">
                                                <Button Variant="ButtonVariant.Ghost"
                                                        Size="ButtonSize.Sm"
                                                        OnClick="@(() => OpenEditDialogAsync(investment.Id))">
                                                    @(_canWrite ? "Editar" : "Ver")
                                                </Button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </ChildContent>
            </Card>
        }
        else
        {
            <TrafficDepositsSection />
        }
    </Tabs>
</div>

<TrafficInvestmentFormDialog IsOpen="@_dialogOpen"
                             IsOpenChanged="@OnDialogOpenChangedAsync"
                             EditTarget="@_editTarget"
                             Projects="@_projects"
                             YearOptions="@_yearOptions"
                             DefaultMonth="@_defaultMonth"
                             DefaultYear="@_defaultYear"
                             CanWrite="@_canWrite"
                             IsSaving="@_isSaving"
                             ErrorMessage="@_formError"
                             OnSubmit="@SaveAsync" />

@code {
    private readonly string[] _tabs = ["Investimentos", "Aportes"];
    private readonly List<TrafficInvestmentListItemDto> _investments = [];
    private readonly List<ProjectDto> _projects = [];
    private readonly int[] _yearOptions = BuildYearOptions();

    private bool _isLoading = true;
    private bool _isLoadingProjects = true;
    private bool _isSaving;
    private bool _canWrite;
    private int _activeTab;
    private string? _loadError;
    private string? _actionMessage;
    private string? _actionError;
    private string? _formError;
    private bool _dialogOpen;
    private TrafficInvestmentDto? _editTarget;
    private Guid? _editInvestmentId;

    private string _monthFilter = string.Empty;
    private string _yearFilter = string.Empty;
    private string _projectFilter = string.Empty;
    private int _defaultMonth;
    private int _defaultYear;

    protected override async Task OnInitializedAsync()
    {
        var now = DateTime.UtcNow;
        _defaultMonth = now.Month;
        _defaultYear = now.Year;
        _monthFilter = _defaultMonth.ToString();
        _yearFilter = _defaultYear.ToString();

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var writeAuthorization = await AuthorizationService.AuthorizeAsync(
            authState.User,
            AppPolicies.TrafficWrite);
        _canWrite = writeAuthorization.Succeeded;

        await LoadProjectsAsync();
        await LoadInvestmentsAsync();
    }

    private static int[] BuildYearOptions()
    {
        var currentYear = DateTime.UtcNow.Year;
        return Enumerable.Range(currentYear - 2, 5).Reverse().ToArray();
    }

    private async Task LoadProjectsAsync()
    {
        _isLoadingProjects = true;
        _projects.Clear();

        var result = await ProjectApiService.GetProjectsAsync();
        if (result.Status == ProjectApiStatus.Success && result.Projects is not null)
        {
            _projects.AddRange(result.Projects.OrderBy(project => project.Name, StringComparer.OrdinalIgnoreCase));
        }

        _isLoadingProjects = false;
    }

    private async Task LoadInvestmentsAsync()
    {
        _isLoading = true;
        _loadError = null;
        _investments.Clear();
        _actionMessage = null;
        _actionError = null;

        var result = await TrafficInvestmentApiService.GetInvestmentsAsync(BuildListQuery());
        if (result.Status == TrafficInvestmentApiStatus.Success && result.Investments is not null)
        {
            _investments.AddRange(result.Investments);
        }
        else
        {
            _loadError = TrafficInvestmentErrorMessages.ForList(result);
        }

        _isLoading = false;
    }

    private TrafficInvestmentListQuery BuildListQuery() =>
        new(
            ParseIntFilter(_monthFilter),
            ParseIntFilter(_yearFilter),
            ParseGuidFilter(_projectFilter));

    private static int? ParseIntFilter(string value) =>
        int.TryParse(value, out var parsed) ? parsed : null;

    private static Guid? ParseGuidFilter(string value) =>
        Guid.TryParse(value, out var parsed) ? parsed : null;

    private string GetEmptyStateDescription() =>
        _canWrite
            ? "Cadastre o investimento do mês ou ajuste os filtros."
            : "Ajuste os filtros para encontrar registros.";

    private Task OnTabChangedAsync(int tabIndex)
    {
        _activeTab = tabIndex;
        return Task.CompletedTask;
    }

    private async Task OnMonthFilterChangedAsync(string? value)
    {
        _monthFilter = value ?? string.Empty;
        await LoadInvestmentsAsync();
    }

    private async Task OnYearFilterChangedAsync(string? value)
    {
        _yearFilter = value ?? string.Empty;
        await LoadInvestmentsAsync();
    }

    private async Task OnProjectFilterChangedAsync(string? value)
    {
        _projectFilter = value ?? string.Empty;
        await LoadInvestmentsAsync();
    }

    private Task OpenCreateDialogAsync()
    {
        _editTarget = null;
        _editInvestmentId = null;
        _formError = null;
        _dialogOpen = true;
        return Task.CompletedTask;
    }

    private async Task OpenEditDialogAsync(Guid investmentId)
    {
        _formError = null;
        _editInvestmentId = investmentId;

        var result = await TrafficInvestmentApiService.GetInvestmentByIdAsync(investmentId);
        if (result.Status != TrafficInvestmentApiStatus.Success || result.Investment is null)
        {
            _actionError = TrafficInvestmentErrorMessages.ForList(
                new TrafficInvestmentListResult(result.Status, ErrorCode: result.ErrorCode, Message: result.Message));
            return;
        }

        _editTarget = result.Investment;
        _dialogOpen = true;
    }

    private Task OnDialogOpenChangedAsync(bool isOpen)
    {
        _dialogOpen = isOpen;
        if (!isOpen)
        {
            _editTarget = null;
            _editInvestmentId = null;
            _formError = null;
        }

        return Task.CompletedTask;
    }

    private async Task SaveAsync(TrafficInvestmentRequest request)
    {
        _isSaving = true;
        _formError = null;
        _actionMessage = null;
        _actionError = null;

        TrafficInvestmentMutationResult result = _editInvestmentId is null
            ? await TrafficInvestmentApiService.CreateInvestmentAsync(request)
            : await TrafficInvestmentApiService.UpdateInvestmentAsync(_editInvestmentId.Value, request);

        if (result.Status == TrafficInvestmentApiStatus.Success && result.Investment is not null)
        {
            _dialogOpen = false;
            _editTarget = null;
            _editInvestmentId = null;
            _monthFilter = result.Investment.Month.ToString();
            _yearFilter = result.Investment.Year.ToString();
            _actionMessage = "Investimento salvo com sucesso.";
            await LoadInvestmentsAsync();
        }
        else
        {
            _formError = TrafficInvestmentErrorMessages.ForMutation(result);
            if (result.Investment is not null)
            {
                _editTarget = result.Investment;
            }
        }

        _isSaving = false;
    }
}
