<div class="ui-section-header">
    <div class="ui-section-header__title">
        <Icon Kind="@Icon" Size="IconSize.Default" Class="ui-section-header__icon" />
        <h2 class="text-card-title">@Title</h2>
    </div>
    @if (Actions is not null)
    {
        <div class="ui-section-header__actions">
            @Actions
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter, EditorRequired] public IconKind Icon { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
}
