<div class="settings-form__actions">
    @if (ShowSubmit)
    {
        <Button Disabled="@IsSaving" OnClick="@OnSubmit">
            <Icon Kind="IconKind.Check" />
            @SubmitLabel
        </Button>
    }
    <Button Variant="ButtonVariant.Outline" Disabled="@IsSaving" OnClick="@OnCancel">
        <Icon Kind="IconKind.X" />
        Cancelar
    </Button>
</div>

@code {
    [Parameter] public bool IsSaving { get; set; }
    [Parameter] public bool ShowSubmit { get; set; } = true;
    [Parameter] public string SubmitLabel { get; set; } = "Salvar";
    [Parameter] public EventCallback OnSubmit { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
}
