@{
    var initials = AvatarInitials.FromName(Name);
    var sizeClass = Size == AvatarSize.Sm ? "ui-avatar--sm" : "ui-avatar--md";
}

<div class="ui-avatar @sizeClass" title="@Name">
    @if (!string.IsNullOrWhiteSpace(ImageUrl) && !_imageFailed)
    {
        <img class="ui-avatar__image" src="@ImageUrl" alt="@Name" @onerror="HandleImageError" />
    }
    else
    {
        <span class="ui-avatar__initials">@initials</span>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = string.Empty;
    [Parameter] public string? ImageUrl { get; set; }
    [Parameter] public AvatarSize Size { get; set; } = AvatarSize.Md;

    private bool _imageFailed;

    protected override void OnParametersSet()
    {
        _imageFailed = false;
    }

    private void HandleImageError() => _imageFailed = true;
}
