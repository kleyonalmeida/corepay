@page "/dev/kitchen"

<PageTitle>Kitchen — CorePay</PageTitle>

<div class="kitchen-page">
    <header class="kitchen-header">
        <div>
            <h1 class="text-page-title">Componentes base</h1>
            <p class="text-page-subtitle">Vitrine da Fase 1.3 — identidade visual Lumea</p>
        </div>
        <ThemeToggle />
    </header>

    <section class="kitchen-section" data-kitchen="button">
        <h2 class="text-card-title kitchen-section__title">Botão</h2>
        <div class="kitchen-row">
            <Button Variant="ButtonVariant.Default">Nova Folha</Button>
            <Button Variant="ButtonVariant.Outline">Editar</Button>
            <Button Variant="ButtonVariant.Ghost">Cancelar</Button>
            <Button Variant="ButtonVariant.Destructive">Excluir</Button>
            <Button Variant="ButtonVariant.Secondary">Secundário</Button>
            <Button Size="ButtonSize.Sm">Pequeno</Button>
            <Button Size="ButtonSize.Icon" AriaLabel="Adicionar">
                <Icon Kind="IconKind.Plus" />
            </Button>
        </div>
        <p class="kitchen-note">CTA usa raio de controle (~8–10px), não pill.</p>
    </section>

    <section class="kitchen-section" data-kitchen="status-badge">
        <h2 class="text-card-title kitchen-section__title">StatusBadge</h2>
        <div class="kitchen-row">
            <StatusBadge Kind="StatusKind.Draft" />
            <StatusBadge Kind="StatusKind.PendingApproval" />
            <StatusBadge Kind="StatusKind.Approved" />
            <StatusBadge Kind="StatusKind.Rejected" />
            <StatusBadge Kind="StatusKind.Paid" />
            <StatusBadge Kind="StatusKind.Pending" />
            <StatusBadge Kind="StatusKind.Active" />
            <StatusBadge Kind="StatusKind.Inactive" />
            <StatusBadge Kind="StatusKind.NfSent" />
            <StatusBadge Kind="StatusKind.NfPending" />
        </div>
    </section>

    <section class="kitchen-section" data-kitchen="stat-card">
        <h2 class="text-card-title kitchen-section__title">Stat card</h2>
        <div class="kitchen-stat-grid">
            <StatCard Label="Folhas de Pagamento" Value="12" ValueText="12" Tone="SemanticTone.Blue" Subtitle="Competência atual" />
            <StatCard Label="Aguardando" Value="3" ValueText="3" Tone="SemanticTone.Yellow" />
            <StatCard Label="Total a pagar" Value="123456.78m" Tone="SemanticTone.Primary" />
            <StatCard Label="Total pago" Value="98765.43m" Tone="SemanticTone.Emerald" />
        </div>
    </section>

    <section class="kitchen-section" data-kitchen="card">
        <h2 class="text-card-title kitchen-section__title">Card</h2>
        <Card HeaderContent="@CardHeader">
            <p class="text-body">Superfície com borda 1px e raio de 12px, sem sombra pesada.</p>
        </Card>
    </section>

    <section class="kitchen-section" data-kitchen="input">
        <h2 class="text-card-title kitchen-section__title">Input denso</h2>
        <div class="kitchen-grid">
            <Input Label="Nome" Placeholder="Digite o nome" @bind-Value="_name" />
            <Input Label="Valor" IsMoney="true" Placeholder="0,00" @bind-Value="_amount" />
        </div>
    </section>

    <section class="kitchen-section" data-kitchen="select">
        <h2 class="text-card-title kitchen-section__title">Select estilizado</h2>
        <Select Label="Status" @bind-Value="_status">
            <option value="draft">Rascunho</option>
            <option value="pending_approval">Aguard. Aprovação</option>
            <option value="approved">Aprovada</option>
        </Select>
    </section>

    <section class="kitchen-section" data-kitchen="tabs">
        <h2 class="text-card-title kitchen-section__title">Tabs</h2>
        <Tabs Items="@_tabs" ActiveTab="_activeTab" ActiveTabChanged="HandleTabChanged">
            <p class="text-body">Conteúdo da aba: <strong>@_tabs[_activeTab]</strong></p>
        </Tabs>
    </section>

    <section class="kitchen-section" data-kitchen="dialog">
        <h2 class="text-card-title kitchen-section__title">Dialog</h2>
        <Button Variant="ButtonVariant.Outline" OnClick="OpenDialog">Abrir dialog</Button>
        <Dialog @bind-IsOpen="_dialogOpen" Title="Confirmar ação">
            <p class="text-body">Deseja continuar com esta operação?</p>
            <div class="kitchen-row" style="margin-top: 1rem;">
                <Button Variant="ButtonVariant.Default" OnClick="CloseDialog">Confirmar</Button>
                <Button Variant="ButtonVariant.Ghost" OnClick="CloseDialog">Cancelar</Button>
            </div>
        </Dialog>
    </section>

    <section class="kitchen-section" data-kitchen="goal-toggle">
        <h2 class="text-card-title kitchen-section__title">Toggle de meta</h2>
        <GoalToggle Label="Meta atingida" @bind-Value="_goalReached" />
        <p class="kitchen-note">Estado ligado usa emerald, não primary.</p>
    </section>

    <section class="kitchen-section" data-kitchen="avatar">
        <h2 class="text-card-title kitchen-section__title">Avatar</h2>
        <div class="kitchen-row">
            <Avatar Name="Ana Silva" Size="AvatarSize.Md" />
            <Avatar Name="João Pedro" Size="AvatarSize.Sm" />
            <Avatar Name="Maria Clara Souza" ImageUrl="https://api.dicebear.com/7.x/initials/svg?seed=MC" />
        </div>
    </section>

    <section class="kitchen-section" data-kitchen="spinner">
        <h2 class="text-card-title kitchen-section__title">Spinner</h2>
        <Spinner />
    </section>

    <section class="kitchen-section" data-kitchen="empty-state">
        <h2 class="text-card-title kitchen-section__title">Empty state</h2>
        <Card>
            <EmptyState Title="Nenhum registro encontrado"
                        Description="Crie o primeiro item para começar a usar esta área." />
        </Card>
    </section>

    <section class="kitchen-section" data-kitchen="icons">
        <h2 class="text-card-title kitchen-section__title">Ícones Lucide</h2>
        <p class="kitchen-note">Catálogo da §5 — stroke linear, sem filled. Tamanhos: 16px padrão, 20px topbar, 28px auth, 32px empty.</p>

        <h3 class="text-label kitchen-section__subtitle">Navegação</h3>
        <div class="kitchen-icon-grid">
            @foreach (var entry in _navIcons)
            {
                <div class="kitchen-icon-item">
                    <Icon Kind="@entry.Kind" />
                    <span class="kitchen-icon-item__label">@entry.Label</span>
                </div>
            }
        </div>

        <h3 class="text-label kitchen-section__subtitle">Ações e auxiliares</h3>
        <div class="kitchen-icon-grid">
            @foreach (var entry in _actionIcons)
            {
                <div class="kitchen-icon-item">
                    <Icon Kind="@entry.Kind" />
                    <span class="kitchen-icon-item__label">@entry.Label</span>
                </div>
            }
        </div>

        <h3 class="text-label kitchen-section__subtitle">Tamanhos semânticos</h3>
        <div class="kitchen-row">
            <div class="kitchen-icon-item">
                <Icon Kind="IconKind.Bell" Size="IconSize.Default" />
                <span class="kitchen-icon-item__label">16px default</span>
            </div>
            <div class="kitchen-icon-item">
                <Icon Kind="IconKind.Bell" Size="IconSize.Topbar" />
                <span class="kitchen-icon-item__label">20px topbar</span>
            </div>
            <div class="kitchen-icon-item">
                <Icon Kind="IconKind.DollarSign" Size="IconSize.AuthHero" />
                <span class="kitchen-icon-item__label">28px auth</span>
            </div>
            <div class="kitchen-icon-item">
                <Icon Kind="IconKind.Search" Size="IconSize.EmptyState" />
                <span class="kitchen-icon-item__label">32px empty</span>
            </div>
        </div>
    </section>
</div>

@code {
    private readonly (IconKind Kind, string Label)[] _navIcons =
    [
        (IconKind.LayoutDashboard, "Dashboard"),
        (IconKind.FileText, "Folhas de Pagamento"),
        (IconKind.Users, "Colaboradores"),
        (IconKind.TrendingUp, "Faturamento"),
        (IconKind.Target, "Tráfego"),
        (IconKind.DollarSign, "Financeiro"),
        (IconKind.Building2, "Fluxo de Caixa"),
        (IconKind.BarChart3, "Relatórios"),
        (IconKind.Settings, "Configurações"),
        (IconKind.LogOut, "Sair"),
        (IconKind.Sun, "Tema (dark)"),
        (IconKind.Moon, "Tema (light)"),
        (IconKind.Bell, "Notificações"),
        (IconKind.PanelLeftClose, "Recolher"),
        (IconKind.PanelLeftOpen, "Expandir")
    ];

    private readonly (IconKind Kind, string Label)[] _actionIcons =
    [
        (IconKind.Plus, "Plus"),
        (IconKind.Pencil, "Pencil"),
        (IconKind.Trash2, "Trash2"),
        (IconKind.Search, "Search"),
        (IconKind.ExternalLink, "ExternalLink"),
        (IconKind.Check, "Check"),
        (IconKind.X, "X"),
        (IconKind.UserCheck, "UserCheck"),
        (IconKind.UserX, "UserX"),
        (IconKind.CheckCircle2, "CheckCircle2"),
        (IconKind.Wallet, "Wallet"),
        (IconKind.Calendar, "Calendar")
    ];

    private readonly string[] _tabs = ["Colaboradores", "Custo por Projeto"];
    private int _activeTab;
    private bool _dialogOpen;
    private bool _goalReached = true;
    private string? _name;
    private string? _amount;
    private string? _status = "draft";

    private RenderFragment CardHeader => builder =>
    {
        builder.OpenElement(0, "h3");
        builder.AddAttribute(1, "class", "text-card-title");
        builder.AddContent(2, "Card de superfície");
        builder.CloseElement();
    };

    private Task HandleTabChanged(int index)
    {
        _activeTab = index;
        return Task.CompletedTask;
    }

    private void OpenDialog()
    {
        _dialogOpen = true;
    }

    private void CloseDialog()
    {
        _dialogOpen = false;
    }
}
