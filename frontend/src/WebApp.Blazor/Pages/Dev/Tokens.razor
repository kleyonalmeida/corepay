@page "/dev/tokens"

<PageTitle>Tokens — CorePay</PageTitle>

<div class="tokens-page">
    <header class="tokens-header">
        <div>
            <h1>Tokens de identidade visual</h1>
            <p class="tokens-subtitle">Amostras semânticas Lumea light/dark</p>
        </div>
        <ThemeToggle />
    </header>

    <div class="tokens-grid">
        <article class="token-sample" data-token="background">
            <div class="token-sample__swatch token-sample__swatch--background"></div>
            <div class="token-sample__meta">
                <strong>background</strong>
                <span>Canvas da página</span>
            </div>
        </article>

        <article class="token-sample" data-token="card">
            <div class="token-sample__swatch token-sample__swatch--card"></div>
            <div class="token-sample__meta">
                <strong>card</strong>
                <span>Superfície de card/tabela</span>
            </div>
        </article>

        <article class="token-sample" data-token="primary">
            <div class="token-sample__swatch token-sample__swatch--primary"></div>
            <div class="token-sample__meta">
                <strong>primary</strong>
                <span>#00F2EA — CTA e acento cyan Lumea</span>
            </div>
        </article>

        <article class="token-sample" data-token="destructive">
            <div class="token-sample__swatch token-sample__swatch--destructive"></div>
            <div class="token-sample__meta">
                <strong>destructive</strong>
                <span>Erro, excluir, alertas críticos</span>
            </div>
        </article>

        <article class="token-sample" data-token="sidebar">
            <div class="token-sample__swatch token-sample__swatch--sidebar"></div>
            <div class="token-sample__meta">
                <strong>sidebar</strong>
                <span>sidebar-background — navegação lateral</span>
            </div>
        </article>
    </div>
</div>
