# SQL Server (docker-compose)
# Senha padrão de desenvolvimento local — altere em produção.
MSSQL_SA_PASSWORD=Your_strong_Password123!
MSSQL_DATABASE=CorePay

# Portas expostas no host
BACKEND_PORT=5000
FRONTEND_PORT=5173
SQLSERVER_PORT=1433

# Frontend — URL pública da API (Blazor WASM)
# Dev local: http://localhost:5000
# Prod (docker-compose.prod.yml): URL HTTPS pública da API, ex. https://api.seudominio.com
API_BASE_URL=http://localhost:5000

# CORS da API em produção (obrigatório no docker-compose.prod.yml)
# Origens HTTPS separadas por vírgula, sem localhost nem wildcard
# Cors__AllowedOrigins=https://app.seudominio.com

# Connection string da API (obrigatória fora do ambiente Testing)
# Use a mesma senha definida em MSSQL_SA_PASSWORD
ConnectionStrings__DefaultConnection="Server=localhost,1433;Database=CorePay;User Id=sa;Password=Your_strong_Password123!;TrustServerCertificate=True;MultipleActiveResultSets=true"

# JWT (API) — mínimo 32 caracteres; NÃO commitar valor real em produção
Jwt__Key=dev-only-signing-key-at-least-32-chars
Jwt__ExpirationMinutes=480

# Webhook Facilities (API) — mínimo 32 caracteres
Facilities__WebhookSecret=dev-only-facilities-webhook-secret-at-least-32-chars

# SuperAdmin seed (API) — obrigatório no primeiro startup
Seed__SuperAdmin__Email=admin@example.local
Seed__SuperAdmin__Password=ChangeMe-SuperAdmin-Password-123!

# Usuários locais por papel (opcional) — senha compartilhada ao rodar scripts/seed-local-role-users.sh
DEV_ROLE_USERS_PASSWORD=ChangeMe-Role-Users-123!
